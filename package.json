{
  "name": "chatplayground-cli",
  "version": "1.2.0",
  "description": "Terminal CLI client for ChatPlayground AI: Claude Sonnet 5, DeepSeek R1, Gemini 3.8, GPT-5.6, and image generation with GPT Image 2",
  "main": "bin/cli.js",
  "bin": {
    "chatplayground": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node bin/cli.js -v"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shaoyanji/chatplayground-cli.git"
  },
  "keywords": [
    "chatplayground",
    "claude-sonnet-5",
    "claude-3-5-sonnet",
    "gpt-image-2",
    "deepseek-r1",
    "gemini",
    "cli",
    "terminal",
    "ai",
    "streaming"
  ],
  "author": "Shao-Yan Ji",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "playwright": ">=1.35.0"
  }
}
